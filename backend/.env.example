# ─── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/corpverse?retryWrites=true&w=majority

# ─── JWT Auth ────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI Microservice (Future) ───────────────────
AI_SERVICE_URL=http://localhost:8000
